<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvTitleDialogCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Custom Order"
        android:textColor="#2B1A12"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoDialogCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Masukkan estimasi harga dan status pesanan."
        android:textColor="#777777"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEstimasiHargaCustom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="#F4F4F4"
        android:hint="Estimasi harga"
        android:inputType="number"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerStatusCustom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="#F4F4F4"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

</LinearLayout>
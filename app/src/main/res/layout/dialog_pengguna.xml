<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvTitleDialogPengguna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah Pengguna"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNamaPengguna"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@color/app_input"
        android:hint="Nama"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etEmailPengguna"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@color/app_input"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPasswordPengguna"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@color/app_input"
        android:hint="Password"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Role"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgRolePengguna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/app_input"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <RadioButton
            android:id="@+id/rbRoleCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand_green"
            android:text="Customer"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbRoleKasir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand_green"
            android:text="Kasir"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbRoleAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/brand_green"
            android:text="Admin"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </RadioGroup>

</LinearLayout>

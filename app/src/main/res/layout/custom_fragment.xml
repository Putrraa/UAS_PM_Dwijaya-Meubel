<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    tools:context="CustomFragment">

    <!-- TOOLBAR -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                android:paddingHorizontal="16dp">

                <!-- Badge "PESAN SEKARANG" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PESAN SEKARANG"
                    android:textSize="11sp"
                    android:textColor="#B8860B"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Furniture"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ceritakan furnitur impian Anda — kami wujudkan dengan tangan."
                    android:textSize="13sp"
                    android:textColor="#777777"
                    android:gravity="center" />
            </LinearLayout>

            <!-- FORM CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- ===== SEKSI: SPESIFIKASI FURNITURE ===== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SPESIFIKASI FURNITURE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#999999"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />

                    <!-- Row: Jenis Furniture + Jenis Kayu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- Jenis Furniture -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JENIS FURNITURE *"
                                android:textSize="10sp"
                                android:textColor="#555555"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                app:boxStrokeColor="#CCCCCC">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJenisFurniture"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Contoh: Meja, Kursi, Lemari, dll."
                                    android:textSize="13sp"
                                    android:inputType="text"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Jenis Kayu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JENIS KAYU *"
                                android:textSize="10sp"
                                android:textColor="#555555"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                app:boxStrokeColor="#CCCCCC">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJenisKayu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Contoh: Jati, Mahoni, Pinus."
                                    android:textSize="13sp"
                                    android:inputType="text"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Ukuran -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UKURAN *"
                            android:textSize="10sp"
                            android:textColor="#555555"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                            app:boxStrokeColor="#CCCCCC">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUkuran"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Contoh: 120×60×75 cm (P×L×T)"
                                android:textSize="13sp"
                                android:inputType="text"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gunakan format: Panjang × Lebar × Tinggi dalam cm"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- DIVIDER -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="16dp" />

                    <!-- ===== SEKSI: REFERENSI DESAIN ===== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="REFERENSI DESAIN"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#999999"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp" />

                    <!-- Gambar Referensi Upload -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAMBAR REFERENSI"
                        android:textSize="10sp"
                        android:textColor="#555555"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Area Upload -->
                    <FrameLayout
                        android:id="@+id/layoutUploadGambar"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_upload_area"
                        android:layout_marginBottom="16dp">

                        <!-- State: Belum ada gambar -->
                        <LinearLayout
                            android:id="@+id/layoutUploadPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="visible">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_upload"
                                android:alpha="0.4"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Klik untuk unggah gambar referensi"
                                android:textSize="13sp"
                                android:textColor="#999999" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JPG, PNG, WEBP · Maks 2MB"
                                android:textSize="11sp"
                                android:textColor="#BBBBBB"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- State: Gambar sudah dipilih (visible setelah user upload) -->
                        <ImageView
                            android:id="@+id/imgReferensiPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Tombol ganti gambar (muncul setelah upload) -->
                        <ImageButton
                            android:id="@+id/btnHapusGambar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:src="@drawable/ic_close"
                            android:background="@drawable/bg_circle_dark"
                            android:visibility="gone"
                            android:contentDescription="Hapus gambar" />
                    </FrameLayout>

                    <!-- Catatan Tambahan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATATAN TAMBAHAN"
                        android:textSize="10sp"
                        android:textColor="#555555"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="#CCCCCC"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCatatanTambahan"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:hint="Tuliskan detail tambahan: warna finishing, motif ukiran, material khusus, atau kebutuhan lain..."
                            android:textSize="13sp"
                            android:inputType="textMultiLine"
                            android:gravity="top|start"
                            android:minLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- FOOTER FORM: Info + Tombol Kirim -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tim kami akan menghubungi Anda\nuntuk konfirmasi &amp; estimasi harga."
                            android:textSize="12sp"
                            android:textColor="#999999"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnKirimPesanan"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="+ KIRIM PESANAN"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#2D5A3D"
                            android:paddingHorizontal="20dp"
                            style="@style/Widget.MaterialComponents.Button" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
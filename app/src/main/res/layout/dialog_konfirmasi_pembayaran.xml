<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:background="@android:color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Konfirmasi Pembayaran"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTutupKonfirmasi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_close"
            android:contentDescription="Tutup" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />

    <!-- Body: 2 kolom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ===== KOLOM KIRI: Ringkasan Pesanan ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.42"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FAFAFA">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ringkasan Pesanan"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- RecyclerView item ringkasan -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRingkasanPesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Spacer fleksibel -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <!-- Total Pembayaran -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Pembayaran"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKonfirmasiTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 4.000.000"
                    android:textColor="#C0392B"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ===== KOLOM KANAN: Alamat Pengiriman ===== -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.58"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alamat Pengiriman"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp" />

                <!-- Nama Penerima -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Penerima"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNamaPenerima"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Nomor Telepon -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nomor Telepon"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNomorTelepon"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="phone"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Alamat Lengkap -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alamat Lengkap"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etAlamatLengkap"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:gravity="top|start"
                    android:layout_marginBottom="16dp" />

                <!-- Row: Kota + Kode Pos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Kota -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kota"
                            android:textColor="#555555"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etKota"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_input_field"
                            android:inputType="textCapWords"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Kode Pos -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kode Pos"
                            android:textColor="#555555"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/etKodePos"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:background="@drawable/bg_input_field"
                            android:inputType="number"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Catatan Opsional -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan (opsional)"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/bg_input_field"
                    android:inputType="textMultiLine"
                    android:textSize="14sp"
                    android:gravity="top|start" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- Divider sebelum footer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8" />

    <!-- ===== FOOTER: Total + Tombol ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Total kiri bawah -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pembayaran"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFooterTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 4.000.000"
                android:textColor="#C0392B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Batal -->
        <Button
            android:id="@+id/btnBatal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Batal"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:background="@drawable/bg_btn_dark"
            android:stateListAnimator="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="12dp" />

        <!-- Tombol Bayar dengan Midtrans -->
        <Button
            android:id="@+id/btnBayarMidtrans"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Bayar dengan Midtrans"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_dark_green"
            android:stateListAnimator="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

    </LinearLayout>

</LinearLayout>

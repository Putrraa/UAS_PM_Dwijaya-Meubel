<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical">

        <!-- HEADER MODAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/brand_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detail Produk"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tutup"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- GAMBAR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@color/app_surface_muted"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgDetailProduk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Gambar produk"
                android:scaleType="centerInside"
                tools:src="@drawable/home" />

        </FrameLayout>

        <!-- DETAIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvDetailNamaProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="MEJA KAYU JATI" />

            <TextView
                android:id="@+id/tvDetailHargaProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/status_danger"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Rp 1.500.000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/app_divider" />

            <TextView
                android:id="@+id/tvDetailKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Kategori: Meja" />

            <TextView
                android:id="@+id/tvDetailBahan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Bahan: Kayu Jati" />

            <TextView
                android:id="@+id/tvDetailUkuran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Ukuran: 120 x 60 cm" />

            <TextView
                android:id="@+id/tvDetailStok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="@color/status_success"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="✔ Tersedia (10)" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Deskripsi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Produk furniture berkualitas dengan bahan pilihan." />

            <!-- QTY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMinusQty"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_dark_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="-"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQtyProduk"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPlusQty"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_dark_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="+"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/status_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Total: Rp 1.500.000" />

            <Button
                android:id="@+id/btnAddCartDialog"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_dark_green"
                android:stateListAnimator="@null"
                android:text="ADD TO CART"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

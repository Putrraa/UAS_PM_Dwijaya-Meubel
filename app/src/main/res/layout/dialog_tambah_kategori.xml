<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Kategori"
            android:textColor="@color/brand_green_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="Masukkan nama kategori dan gambar kategori"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/imgPreviewKategori"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="10dp"
            android:background="@color/app_background"
            android:contentDescription="Preview gambar kategori"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/home" />

        <Button
            android:id="@+id/btnPilihGambarKategori"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/brand_green_soft"
            android:text="Pilih Gambar Kategori"
            android:textColor="@color/brand_green"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Kategori">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNamaKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatalKategori"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_green_soft"
                android:text="Batal"
                android:textColor="@color/brand_green"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSimpanKategori"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/brand_green"
                android:text="Simpan"
                android:textColor="@color/app_surface"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
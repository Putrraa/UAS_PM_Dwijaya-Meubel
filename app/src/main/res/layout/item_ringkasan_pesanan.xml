<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp">

    <!-- Thumbnail produk -->
    <ImageView
        android:id="@+id/ivRingkasanGambar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:background="@color/app_input"
        android:layout_marginEnd="12dp" />

    <!-- Nama + qty x harga -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRingkasanNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="lemari"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvRingkasanQtyHarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2x · Rp 2.000.000"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Subtotal -->
    <TextView
        android:id="@+id/tvRingkasanSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 4.000.000"
        android:textColor="@color/status_danger"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>

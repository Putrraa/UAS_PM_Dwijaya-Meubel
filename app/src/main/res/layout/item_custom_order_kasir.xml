<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="92dp"
                android:layout_height="92dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEEEEE">

                <ImageView
                    android:id="@+id/imgCustomOrderKasir"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFurnitureCustomKasir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#2B1A12"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Meja Custom" />

                    <TextView
                        android:id="@+id/tvStatusCustomKasir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#EAF1EC"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:textColor="#3D5A4A"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Pending" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCustomerCustomKasir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    tools:text="Customer: Daffa" />

                <TextView
                    android:id="@+id/tvKayuCustomKasir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    tools:text="Kayu: Jati" />

                <TextView
                    android:id="@+id/tvUkuranCustomKasir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    tools:text="Ukuran: 120x60x75 cm" />

                <TextView
                    android:id="@+id/tvHargaCustomKasir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#1F7A1F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Rp 2.000.000" />

            </LinearLayout>

        </LinearLayout>

        <!-- CATATAN -->
        <TextView
            android:id="@+id/tvCatatanCustomKasir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F7F7F7"
            android:padding="10dp"
            android:textColor="#666666"
            android:textSize="12sp"
            tools:text="Catatan: Tolong dibuat warna coklat tua." />

        <!-- BUTTON -->
        <Button
            android:id="@+id/btnUpdateCustomKasir"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#3D5A4A"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Update Harga &amp; Status"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Furniture: thumbnail + nama -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivFurnitureThumbnail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:background="@color/app_input"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvFurnitureNama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meja"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Kayu -->
    <TextView
        android:id="@+id/tvKayu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:text="Mahoni"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:maxLines="2"
        android:gravity="center" />

    <!-- Ukuran -->
    <TextView
        android:id="@+id/tvUkuran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="500x60x75"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:maxLines="2"
        android:gravity="center" />

    <!-- Harga + Tombol Bayar -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvHarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 2jt"
            android:textColor="@color/status_success"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/btnBayarSekarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_dark_green"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Bayar"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- Status Badge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:gravity="center">

        <TextView
            android:id="@+id/tvStatusCustom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_status_pending" />
    </LinearLayout>

</LinearLayout>
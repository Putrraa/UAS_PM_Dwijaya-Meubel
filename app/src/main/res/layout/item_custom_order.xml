<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Furniture (thumbnail + nama) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivFurnitureThumbnail"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFurnitureNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="meja"
            android:textColor="#1A1A1A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Kayu -->
    <TextView
        android:id="@+id/tvKayu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="jati"
        android:textColor="#555555"
        android:textSize="11sp" />

    <!-- Ukuran -->
    <TextView
        android:id="@+id/tvUkuran"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="120x120x50"
        android:textColor="#555555"
        android:textSize="11sp" />

    <!-- Harga -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 200.000.000"
            android:textColor="#1F7A1F"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Tombol Bayar Sekarang -->
        <Button
            android:id="@+id/btnBayarSekarang"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Bayar Sekarang"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:background="@drawable/bg_btn_dark_green"
            android:stateListAnimator="@null"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatusCustom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="Pending"
        android:textColor="@android:color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_status_pending" />

</LinearLayout>

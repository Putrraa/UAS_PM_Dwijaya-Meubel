<?xml version="1.0" encoding="utf-8"?>
<!-- item_keranjang.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ROW UTAMA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <!-- Gambar Produk -->
        <ImageView
            android:id="@+id/imgProduk"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#FFCCCC"
            android:layout_marginEnd="10dp" />

        <!-- Nama & Brand -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Lemari" />

            <TextView
                android:id="@+id/tvBrandProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#888888"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Dwijaya Mebel Original" />
        </LinearLayout>

        <!-- Harga Satuan -->
        <TextView
            android:id="@+id/tvHargaSatuan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:textSize="12sp"
            android:textColor="#333333"
            android:gravity="center"
            tools:text="Rp 2.000.000" />

        <!-- Kontrol Jumlah: - qty + -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_qty_control">

            <TextView
                android:id="@+id/btnKurang"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:text="&#8722;"
                android:textSize="18sp"
                android:textColor="#333333"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tvJumlah"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:gravity="center"
                tools:text="2" />

            <TextView
                android:id="@+id/btnTambah"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="18sp"
                android:textColor="#333333"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Subtotal -->
        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"
            tools:text="Rp 4.000.000" />

        <!-- Tombol Hapus -->
        <Button
            android:id="@+id/btnHapus"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.4"
            android:backgroundTint="#1A1A1A"
            android:text="Hapus"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="4dp" />

    </LinearLayout>

    <!-- Divider bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!-- item_keranjang.xml - Row item untuk RecyclerView di halaman Keranjang -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <!-- Gambar Produk -->
    <ImageView
        android:id="@+id/imgProduk"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:background="#FFCCCC"
        android:layout_marginEnd="10dp"
        tools:src="@drawable/ic_launcher_background" />

    <!-- Nama & Brand -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvNamaProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="lemari"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            tools:text="Lemari" />

        <TextView
            android:id="@+id/tvBrandProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dwijaya Mebel Original"
            android:textSize="12sp"
            android:textColor="#777777"
            tools:text="Dwijaya Mebel Original" />
    </LinearLayout>

    <!-- Harga Satuan -->
    <TextView
        android:id="@+id/tvHargaSatuan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="Rp 2.000.000"
        android:textSize="12sp"
        android:textColor="#333333"
        android:gravity="center"
        tools:text="Rp 2.000.000" />

    <!-- Kontrol Jumlah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_qty_control">

        <ImageButton
            android:id="@+id/btnKurang"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_minus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kurangi jumlah" />

        <TextView
            android:id="@+id/tvJumlah"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:gravity="center"
            tools:text="2" />

        <ImageButton
            android:id="@+id/btnTambah"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_plus"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tambah jumlah" />
    </LinearLayout>

    <!-- Subtotal -->
    <TextView
        android:id="@+id/tvSubtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:text="Rp 4.000.000"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:gravity="center"
        tools:text="Rp 4.000.000" />

    <!-- Tombol Hapus -->
    <Button
        android:id="@+id/btnHapus"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1.5"
        android:text="Hapus"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A1A1A"
        android:paddingHorizontal="4dp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- PRODUK: Thumbnail + Nama + Sub-nama -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivKeranjangGambar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvKeranjangNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lemari"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvKeranjangSubNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dwijaya Mebel Original"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- HARGA -->
    <TextView
        android:id="@+id/tvKeranjangHarga"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Rp 2.000.000"
        android:textColor="#1A1A1A"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- JUMLAH: − qty + -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnKurangKeranjang"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="−"
            android:textSize="16sp"
            android:textColor="#1A1A1A"
            android:background="@drawable/bg_qty_btn"
            android:stateListAnimator="@null"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/tvKeranjangQty"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="2"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTambahKeranjang"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textSize="16sp"
            android:textColor="#1A1A1A"
            android:background="@drawable/bg_qty_btn"
            android:stateListAnimator="@null"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- SUBTOTAL -->
    <TextView
        android:id="@+id/tvKeranjangSubtotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Rp 4.000.000"
        android:textColor="#C0392B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- AKSI: Tombol Hapus -->
    <Button
        android:id="@+id/btnHapusKeranjang"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="0.7"
        android:text="Hapus"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:background="@drawable/bg_btn_dark"
        android:stateListAnimator="@null" />

</LinearLayout>
